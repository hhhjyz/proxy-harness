{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/proxy-harness/scene-spec-1.0.schema.json",
  "title": "Proxy Harness scene specification, version 1.0",
  "description": "Screen coverage thresholds are opt-in. Active intervals are half-open [start, end). Camera pitch is signed elevation from the horizontal; a downward-looking camera has negative pitch.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "prompt", "duration_s", "fps", "width", "height", "sample_times", "subjects"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "prompt": {"type": "string", "minLength": 1},
    "split": {"type": "string", "enum": ["train", "dev", "holdout", "demo"], "default": "demo"},
    "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295, "default": 42},
    "duration_s": {"type": "number", "exclusiveMinimum": 0},
    "fps": {"type": "number", "exclusiveMinimum": 0},
    "width": {"type": "integer", "minimum": 2, "multipleOf": 2},
    "height": {"type": "integer", "minimum": 2, "multipleOf": 2},
    "sample_times": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "number", "minimum": 0}},
    "subjects": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/subject"}},
    "camera": {"$ref": "#/$defs/camera", "default": {}},
    "collision": {"$ref": "#/$defs/collision", "default": {}},
    "evaluation": {"$ref": "#/$defs/evaluation", "default": {}}
  },
  "$defs": {
    "interval": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
    "pair": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "minLength": 1}},
    "subject": {
      "type": "object", "additionalProperties": false, "required": ["id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "role": {"type": "string", "enum": ["primary", "secondary", "ground", "decoration", "background"], "default": "primary"},
        "required": {"type": "boolean", "default": true},
        "fully_in_frame": {"type": "boolean", "default": false},
        "min_area_ratio": {"type": "number", "minimum": 0},
        "max_area_ratio": {"type": "number", "minimum": 0},
        "active_intervals": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/interval"}}
      }
    },
    "camera": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "pitch_deg_range": {"$ref": "#/$defs/interval"},
        "height_range": {"$ref": "#/$defs/interval"}
      }
    },
    "collision": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "forbidden_pairs": {"type": "array", "default": [], "items": {"$ref": "#/$defs/pair"}},
        "allowed_pairs": {"type": "array", "default": [], "items": {"$ref": "#/$defs/pair"}},
        "tolerance": {"type": "number", "minimum": 0, "default": 0.001}
      }
    },
    "evaluation": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "pass_score": {"type": "number", "minimum": 0, "maximum": 100, "default": 75},
        "hard_fail_score_cap": {"type": "number", "minimum": 0, "maximum": 100, "default": 40}
      }
    }
  }
}
